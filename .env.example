# Flask
SECRET_KEY=change-me-to-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pemetaan_digital_jabar

# Use 'sqlite' for local dev fallback (no MySQL setup), 'mysql' for production
DB_DRIVER=mysql

# Upload settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
